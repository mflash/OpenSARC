    Namespace="System.Web.UI" TagPrefix="asp" %>

<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <title>Open SARC</title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Early connection hint for CDN -->
    <link rel="preconnect" href="https://cdn.jsdelivr.net" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="shortcut icon" href="../_layouts/logo/favicon.ico" />
</head>

<body class="bg-light">

    <script type="text/javascript">
        function confirm_delete() {
            return confirm("Confirma a exclusão?");
        }
    </script>

    <form id="Form1" runat="server">
        <div class="container-fluid p-0">
            <div class="bg-white border rounded p-2">
                <asp:ContentPlaceHolder ID="cphTitulo" runat="server">
                    <asp:ScriptManager ID="ScriptManager1" runat="server" />
                </asp:ContentPlaceHolder>
            </div>
        </div>
    </form>

    <footer class="text-center text-muted small py-3">
        &copy; 2011 OpenSARC,
        <a href="https://github.com/mflash/OpenSARC">https://github.com/mflash/OpenSARC</a> —
        <a href="https://github.com/mflash/OpenSARC/wiki/Sobre...">Sobre...</a>
        &nbsp;<span id="sarcVersao" runat="server"></span>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" defer></script>
</body>
</html>